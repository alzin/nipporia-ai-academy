# Nipporia AI Academy backend - copy to .env and fill in. Never commit real values.

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 月額プラン ¥4,980 / 年額プラン ¥49,800 (tax included, recurring prices)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Customer portal configuration (bpc_...). Empty = the account default.
STRIPE_PORTAL_CONFIGURATION_ID=
# Prices already include tax. Set to true only after Stripe Tax is set up.
STRIPE_AUTOMATIC_TAX=false

# Email: SMTP when EMAIL_HOST is set (production: smtpout.secureserver.net, port 465, info@nipporia.com),
# otherwise Resend when RESEND_API_KEY is set, otherwise printed to the console.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# AWS S3 (community media uploads)
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Brevo (contact lists)
BREVO_API_KEY=
BREVO_TRANSACTIONAL_LIST_ID=2
BREVO_MARKETING_LIST_ID=3

# Free trial without card (days)
FREE_TRIAL_DAYS=0

# Google sign-in: web OAuth client ID (public). Empty = no Google button.
GOOGLE_CLIENT_ID=
