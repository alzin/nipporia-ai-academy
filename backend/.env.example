# Nipporia AI Academy backend - copy to .env and fill in. Never commit real values.

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ONE_TIME_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_MONTHLY_DISCOUNT_PRICE_ID=
STRIPE_YEARLY_DISCOUNT_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
STRIPE_STANDARD_DISCOUNT_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_DISCOUNT_PRICE_ID=
STRIPE_FREE_DAYS=14
STRIPE_DISCOUNT_LIMIT_USERS=100

# Email (Resend is used by default; EMAIL_HOST/PORT/USER/PASS are for the optional SMTP EmailService)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# AWS S3 (community media uploads)
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Brevo (contact lists)
BREVO_API_KEY=
BREVO_TRANSACTIONAL_LIST_ID=2
BREVO_MARKETING_LIST_ID=3

# Free trial without card (days)
FREE_TRIAL_DAYS=14
